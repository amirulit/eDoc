            border-radius: 4px;
            box-shadow: none;
        }
        .btn-primary
        {
            background-color: #1686c9;
            border-color: #1686c9;
        }
        .content-wrapper .table th
        {
            background: #edf4fa;
            color: #234767;
        }
        .main-footer
        {
            background: #fff;
            color: #718096;
        }
        /* DataTable styling */.dataTables_wrapper
        {
            padding-top: 10px;
        }
        .dataTables_filter input
        {
            border: 1px solid #d4deea;
            border-radius: 5px;
            padding: 6px 10px;
            margin-left: 5px;
        }
        .dataTables_length select
