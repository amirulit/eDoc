            background: #eaf2fb;
            color: #123c67;
            font-weight: 600;
            vertical-align: middle;
        }
        #tblDocuments tbody td
        {
            vertical-align: middle;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current
        {
            background: #1686c9 !important;
            color: #fff !important;
            border: 1px solid #1686c9 !important;
            border-radius: 4px;
        }
    </style>
    <style type="text/css">
        /* Edit Modal */#editDocumentModal .modal-content
        {
            border-radius: 8px;
            border: none;
            box-shadow: 0 10px 35px rgba(0,0,0,.2);
            overflow: hidden;
        }
        #editDocumentModal .modal-header
        {
            padding: 18px 20px;
            border-bottom: none;
        }
        #editDocumentModal .modal-title
        {
            font-size: 18px;
            font-weight: 600;
        }
        #editDocumentModal .modal-body
        {
            padding: 25px;
            background: #fff;
        }
        #editDocumentModal label
        {
            color: #34495e;
            font-weight: 600;
            margin-bottom: 7px;
        }
        #editDocumentModal .form-control
        {
            height: 40px;
            border-radius: 5px;
            border: 1px solid #d4deea;
            box-shadow: none;
        }
        #editDocumentModal textarea.form-control
        {
            height: auto;
        }
        #editDocumentModal .form-control:focus
        {
            border-color: #1686c9;
            box-shadow: 0 0 5px rgba(22,134,201,.2);
        }
        #editDocumentModal .modal-footer
        {
            background: #f7faff;
            border-top: 1px solid #e6edf5;
            padding: 15px 25px;
        }
        /* Compact Sidebar */.skin-blue .main-sidebar
        {
            background: #173b60;
        }
        .skin-blue .sidebar-menu > li > a
        {
            padding: 9px 10px;
            font-size: 13px;
        }
        .skin-blue .sidebar-menu > li > a > i:first-child
        {
            width: 22px;
            font-size: 15px;
        }
        /* Main menu headers */.skin-blue .sidebar-menu > li.header
        {
            padding: 8px 10px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .7px;
        }
        /* Nested menu */.skin-blue .sidebar-menu .treeview-menu
        {
            background: #102f4d;
            padding-left: 0;
        }
        .skin-blue .sidebar-menu .treeview-menu > li > a
        {
            padding: 7px 8px 7px 35px;
            font-size: 12px;
            color: #c5d6e7;
        }
        /* Nested icons */.skin-blue .sidebar-menu .treeview-menu > li > a > i
        {
            width: 18px;
            font-size: 12px;
        }
        /* Hover and active */.skin-blue .sidebar-menu .treeview-menu > li.active > a, .skin-blue .sidebar-menu .treeview-menu > li > a:hover
        {
            color: #fff;
            background: #1265a8;
        }
        /* Active parent */.skin-blue .sidebar-menu > li.active > a
        {
            background: #1265a8;
            color: #fff;
            border-left-color: #36b9e9;
        }
        /* Parent arrow */.sidebar-menu .treeview > a > .pull-right
        {
            transition: transform .2s ease;
        }
        .sidebar-menu .treeview.active > a > .pull-right
        {
            transform: rotate(-90deg);
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
